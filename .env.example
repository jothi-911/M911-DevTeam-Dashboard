# Copy to .env (never commit .env). On Netlify, add these under Site configuration → Environment variables.
DATABASE_URL=postgresql://postgres.xxxxx:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SESSION_SECRET=paste-a-long-random-string-of-at-least-32-characters
SETUP_KEY=a-one-time-key-you-choose-for-first-setup
